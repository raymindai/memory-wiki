{
  "name": "@mdcore/editor",
  "version": "0.2.0",
  "description": "Shared markdown render + TipTap editor config for memory.wiki. Web is the source of truth; this package vendors web's lib/render.ts and components/TiptapLiveEditor.tsx config so every channel (desktop, vscode, quicklook, ios, android) renders identical output.",
  "private": true,
  "main": "./dist/render.js",
  "module": "./dist/render.mjs",
  "types": "./dist/render.d.ts",
  "exports": {
    ".": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.mjs",
      "require": "./dist/render.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.mjs",
      "require": "./dist/render.js"
    },
    "./render.umd": "./dist/render.umd.global.js",
    "./tiptap-config": {
      "types": "./dist/tiptap-config.d.ts",
      "import": "./dist/tiptap-config.mjs",
      "require": "./dist/tiptap-config.js"
    },
    "./tiptap-config.umd": "./dist/tiptap-config.umd.global.js",
    "./mermaid-init": {
      "types": "./dist/mermaid-init.d.ts",
      "import": "./dist/mermaid-init.mjs",
      "require": "./dist/mermaid-init.js"
    },
    "./editor.css": "./dist/editor.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --test __tests__/*.test.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^2.10.0",
    "@tiptap/extension-code-block-lowlight": "^2.10.0",
    "@tiptap/extension-image": "^2.10.0",
    "@tiptap/extension-link": "^2.10.0",
    "@tiptap/extension-placeholder": "^2.10.0",
    "@tiptap/extension-table": "^2.10.0",
    "@tiptap/extension-table-cell": "^2.10.0",
    "@tiptap/extension-table-header": "^2.10.0",
    "@tiptap/extension-table-row": "^2.10.0",
    "@tiptap/extension-task-item": "^2.10.0",
    "@tiptap/extension-task-list": "^2.10.0",
    "@tiptap/pm": "^2.10.0",
    "@tiptap/starter-kit": "^2.10.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.46",
    "lowlight": "^3.3.0",
    "markdown-it": "^14.1.1",
    "markdown-it-footnote": "^4.0.0",
    "tiptap-markdown": "^0.8.10"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "src"
  ]
}

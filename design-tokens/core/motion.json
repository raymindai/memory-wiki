      "base":   { "$value": "200ms", "$type": "duration", "$description": "generic in/out" },
      "slow":   { "$value": "350ms", "$type": "duration", "$description": "page transitions" },
      "push":   { "$value": "280ms", "$type": "duration", "$description": "iOS-style detail-screen slide" },
      "fade":   { "$value": "180ms", "$type": "duration", "$description": "fade-in companion to push" },
      "shake":  { "$value": "320ms", "$type": "duration", "$description": "tab re-tap shake on root" }

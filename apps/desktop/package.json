{
  "name": "memory-wiki-desktop",
  "version": "2.7.0",
  "description": "Native macOS app for memory.wiki: sidebar to your cloud docs, two-way sync, WYSIWYG preview, drag-and-drop import, offline-ready. Same shareable URL Claude, ChatGPT, Cursor, and Gemini all read.",
  "main": "main.js",
  "scripts": {
    "vendor:editor": "./scripts/vendor-editor.sh",
    "prestart": "./scripts/vendor-editor.sh",
    "prebuild": "./scripts/vendor-editor.sh",
    "start": "electron .",
    "build": "electron-builder",
    "build:dmg": "./scripts/vendor-editor.sh && electron-builder --mac dmg && ./scripts/notarize-dmg.sh",
    "build:mas": "./scripts/vendor-editor.sh && electron-builder --mac mas",
    "build:mas:pkg": "./scripts/build-mas.sh",
    "build:all": "./scripts/vendor-editor.sh && electron-builder --mac dmg mas",
    "build:universal": "./scripts/vendor-editor.sh && electron-builder --mac --universal"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.46",
    "markdown-it": "^14.1.1",
    "markdown-it-footnote": "^4.0.0",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "wiki.memory.desktop",
    "productName": "memory.wiki",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "mime-types.js",
      "render.js",
      "vendor-editor/**/*",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json",
      "!wasm/**/*"
    ],
    "afterPack": "./scripts/afterPack.js",
    "protocols": [
      {
        "name": "memory.wiki",
        "schemes": [
          "memorywiki"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": "Hyunsang Cho (W7NL89YGSD)",
      "minimumSystemVersion": "12.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": false
    },
    "mas": {
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "hardenedRuntime": false,
      "type": "distribution",
      "category": "public.app-category.productivity",
      "identity": "Apple Distribution: Hyunsang Cho (W7NL89YGSD)",
      "provisioningProfile": "build/embedded.provisionprofile"
    },
    "pkg": {
      "identity": "3rd Party Mac Developer Installer: Hyunsang Cho (W7NL89YGSD)"
    },
    "dmg": {
      "title": "memory.wiki",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "role": "Editor",
        "icon": "assets/icon.icns"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "role": "Editor",
        "icon": "assets/icon.icns"
      },
      {
        "ext": "txt",
        "name": "Text Document",
        "role": "Editor"
      }
    ]
  }
}

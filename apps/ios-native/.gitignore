# Generated by XcodeGen from project.yml. Regenerate with
# `xcodegen generate` instead of committing a hand-edited project.
*.xcodeproj/

# Local secrets — the .example template is committed; the real
# values live in Secrets.xcconfig and stay out of git.
Config/Secrets.xcconfig

# Xcode user state
*.xcworkspace/xcuserdata/
xcuserdata/
*.xcuserstate

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Carthage / CocoaPods (not used today; ignore proactively in case
# we add native deps later)
Carthage/Build/
Pods/

# Builds
DerivedData/
build/
build-device/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Screenshot + sim build artifacts
screenshots/
build-sim/
build/
ExportOptions sensitive? — no, keep it tracked (above).

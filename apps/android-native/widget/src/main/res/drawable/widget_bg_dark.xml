<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget background — zinc-950 (Brand.Background) with a 16dp
  corner radius and a 0.5dp BorderDim stroke. Matches the
  floating-glass surfaces in the app.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF09090B" />
    <stroke android:width="0.5dp" android:color="#9927272A" />
    <corners android:radius="16dp" />
</shape>

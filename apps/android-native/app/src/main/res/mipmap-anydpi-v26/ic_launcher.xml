<?xml version="1.0" encoding="utf-8"?>
<!--
  No <monochrome> layer. With one set, Pixel Launcher's themed-icon
  mode tints the icon with the wallpaper accent (cyan against a
  cold-blue wallpaper) and draws a hairline ring that doesn't appear
  on apps without themed-icon support. Falling back to the full
  adaptive icon for both standard and themed modes keeps the brand
  ink-on-bone look consistent across launchers.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/brand_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>

<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Don't back up auth tokens or DataStore preferences. The
             user re-signs in on restore — auth follows the account,
             not the device. -->
        <exclude domain="sharedpref" path="auth.xml" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth.xml" />
    </device-transfer>
</data-extraction-rules>

# Memory.Wiki Android — secrets template.
# Copy to secrets.local.properties (gitignored) and fill in the
# values from apps/web/.env.local — same NEXT_PUBLIC_* keys.

MEMORY_WIKI_SUPABASE_URL=https://your-project.supabase.co
MEMORY_WIKI_SUPABASE_ANON_KEY=your-anon-key
MEMORY_WIKI_API_BASE=https://memory.wiki

# Optional — Google sign-in. Get the Web client ID from Firebase /
# Google Cloud console after wiring this app's SHA-256 cert to the
# OAuth credentials.
MEMORY_WIKI_GOOGLE_WEB_CLIENT_ID=
